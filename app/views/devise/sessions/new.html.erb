<h2>Log in</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), class: 'form w-100') do |f| %>
  <div class="text-center mb-10">
		<h1 class="text-dark mb-3">Sign In to Metronic</h1>
		<div class="text-gray-400 fw-bold fs-4">New Here?
		<a href="../../demo2/dist/authentication/layouts/dark/sign-up.html" class="link-primary fw-bolder">Create an Account</a></div>
	</div>
  <div class="fv-row mb-10">
    <%= f.label :email, class: "form-label fs-6 fw-bolder text-dark" %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-lg form-control-solid" %>
  </div>

  <div class="fv-row mb-10">
    <div class='d-flex flex-stack mb-2'>
      <%= f.label :password, class: 'form-label fw-bolder text-dark fs-6 mb-0' %><br />
    </div>
    <%= f.password_field :password, autocomplete: "current-password", class: "form-control form-control-lg form-control-solid " %>
  </div>

  <div class="text-center">
    <%= f.submit "Log in", class: "btn btn-lg btn-primary w-100 mb-5" %>
  </div>
<% end %>

<%#= render "devise/shared/links" %>
