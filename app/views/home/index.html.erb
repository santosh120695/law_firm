<%= content_for :toolbar do %>
    <div class="toolbar py-5 py-lg-15" id="kt_toolbar">
		<div id="kt_toolbar_container" class="container-xxl d-flex flex-stack flex-wrap">
			<div class="page-title d-flex flex-column me-3">
				<h1 class="d-flex text-white fw-bolder my-1 fs-3">Title Dashboard</h1>
			</div>
			<div class="d-flex align-items-center py-3 py-md-1">
				<a class="btn btn-bg-white btn-active-color-primary" href="<%= new_title_path %>" >Create</a>
			</div>
		</div>
	</div>
<% end %>
<div class="row g-5 g-xl-8">
	<div class="col-xl-4">
		<!--begin::Mixed Widget 5-->
		<div class="card card-xl-stretch mb-xl-3">
			<!--begin::Beader-->
			<div class="card-header border-0 py-5">
				<h3 class="card-title align-items-start flex-column">
					<span class="card-label fw-bolder fs-3 mb-1">Summary</span>
					<span class="text-muted fw-bold fs-7">Overall Summary</span>
				</h3>
			</div>
			<!--end::Header-->
			<!--begin::Body-->
			<div class="card-body d-flex flex-column">
				<!--begin::Chart-->
				<!--end::Chart-->
				<!--begin::Items-->
				<div class="mt-5">
					<!--begin::Item-->
					<div class="d-flex flex-stack mb-5">
						<!--begin::Section-->
						<div class="d-flex align-items-center me-2">
							<!--begin::Symbol-->
							<div class="symbol symbol-50px me-3">
								<div class="symbol-label bg-light">
									<img src=<%= asset_path("plurk.svg") %> class="h-50" alt="" />
								</div>
							</div>
							<!--end::Symbol-->
							<!--begin::Title-->
							<div>
								<a href="#" class="fs-6 text-gray-800 text-hover-primary fw-bolder">Total Titles</a>
								<div class="fs-7 text-muted fw-bold mt-1">Total Numbers</div>
							</div>
							<!--end::Title-->
						</div>
						<!--end::Section-->
						<!--begin::Label-->
						<div class="badge badge-light fw-bold py-4 px-3"><%= Title.count %></div>
						<!--end::Label-->
					</div>
					<!--end::Item-->
					<!--begin::Item-->
					<div class="d-flex flex-stack mb-5">
						<!--begin::Section-->
						<div class="d-flex align-items-center me-2">
							<!--begin::Symbol-->
							<div class="symbol symbol-50px me-3">
								<div class="symbol-label bg-light">
									<img src=<%= asset_path("figma-1.svg") %> class="h-50" alt="" />
								</div>
							</div>
							<!--end::Symbol-->
							<!--begin::Title-->
							<div>
								<a href="#" class="fs-6 text-gray-800 text-hover-primary fw-bolder">Pending For Publish</a>
								<div class="fs-7 text-muted fw-bold mt-1">Title Pending for Publish</div>
							</div>
							<!--end::Title-->
						</div>
						<!--end::Section-->
						<!--begin::Label-->
						<div class="badge badge-light fw-bold py-4 px-3">0</div>
						<!--end::Label-->
					</div>
					<!--end::Item-->
					<!--begin::Item-->
					<div class="d-flex flex-stack">
						<!--begin::Section-->
						<div class="d-flex align-items-center me-2">
							<!--begin::Symbol-->
							<div class="symbol symbol-50px me-3">
								<div class="symbol-label bg-light">
									<img src="assets/media/svg/brand-logos/vimeo.svg" class="h-50" alt="" />
								</div>
							</div>
							<!--end::Symbol-->
							<!--begin::Title-->
							<div class="py-1">
								<a href="#" class="fs-6 text-gray-800 text-hover-primary fw-bolder">Pending for Payment</a>
								<div class="fs-7 text-muted fw-bold mt-1">Title Pending for Payments</div>
							</div>
							<!--end::Title-->
						</div>
						<!--end::Section-->
						<!--begin::Label-->
						<div class="badge badge-light fw-bold py-4 px-3">Rs. 200/-</div>
						<!--end::Label-->
					</div>
					<!--end::Item-->
				</div>
				<!--end::Items-->
			</div>
			<!--end::Body-->
		</div>
		<!--end::Mixed Widget 5-->
	</div>
	<div class="col-xl-8">
		<div class="row gx-5 gx-xl-8 mb-5 mb-xl-8">
			<div class="col-xl-3">
				<div class="card h-150px bgi-no-repeat bgi-size-cover card-xl-stretch" style="background-image:url(<%= asset_path('img-75.jpg')%>)">
					<div class="card-body p-6">
						<a href="<%= titles_path %>" class="text-black text-hover-primary fw-bolder fs-2" >View All Titles</a>
					</div>
				</div>
			</div>
			<div class="col-xl-9">
				<div class="card h-150px card-xl-stretch">
					<div class="card-body d-flex align-items-center justify-content-between flex-wrap">
						<div class="me-2">
							<h2 class="fw-bolder text-gray-800 mb-3">Download Pending Title Report</h2>
							<div class="text-muted fw-bold fs-6">Generate the pending title report in excel</div>
						</div>
						<a href="#" class="btn btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#kt_modal_create_campaign">Download</a>
					</div>
				</div>
			</div>
		</div>
		<div class="row gx-5 gx-xl-8 mb-5 mb-xl-8">
			<div class="col-xl-6">
				<div class="card h-175px bgi-no-repeat bgi-size-contain card-xl-stretch mb-5 mb-xl-8" style="background-color: #663259; background-position: right; background-image:url(<%= asset_path('taieri.svg')%> ">
					<div class="card-body d-flex flex-column justify-content-between">
						<!--begin::Title-->
						<h2 class="text-white fw-bolder mb-5">Pending Payment
						<br />Based Reports</h2>
						<!--end::Title-->
						<!--begin::Action-->
						<div class="m-0">
							<a href='#' class="btn btn-danger fw-bold px-6 py-3" data-bs-toggle="modal" data-bs-target="#kt_modal_create_campaign">Download</a>
						</div>
						<!--begin::Action-->
					</div>
					<!--end::Body-->
				</div>
				<div class="row gx-5 gx-xl-8">
					<div class="col-xxl-6">
						<a href="#" class="card card-xxl-stretch bg-primary">
							<div class="card-body d-flex flex-column justify-content-between">
								<span class="svg-icon svg-icon-white svg-icon-2hx ms-n1 flex-grow-1">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
										<rect x="2" y="2" width="9" height="9" rx="2" fill="black" />
										<rect opacity="0.3" x="13" y="2" width="9" height="9" rx="2" fill="black" />
										<rect opacity="0.3" x="13" y="13" width="9" height="9" rx="2" fill="black" />
										<rect opacity="0.3" x="2" y="13" width="9" height="9" rx="2" fill="black" />
									</svg>
								</span>
								<!--end::Svg Icon-->
								<div class="d-flex flex-column">
									<div class="text-white fw-bolder fs-1 mb-0 mt-5">120</div>
									<div class="text-white fw-bold fs-6">Titles Overdue</div>
								</div>
							</div>
							<!--end::Body-->
						</a>
						<!--end::Tiles Widget 5-->
					</div>
					<!--end::Col-->
					<!--begin::Col-->
					<div class="col-xxl-6">
						<!--begin::Tiles Widget 5-->
						<a href="#" class="card card-xxl-stretch bg-body">
							<!--begin::Body-->
							<div class="card-body d-flex flex-column justify-content-between">
								<!--begin::Svg Icon | path: icons/duotune/general/gen002.svg-->
								<span class="svg-icon svg-icon-success svg-icon-2hx ms-n1 flex-grow-1">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
