<div class="card card-flush">
  <div class="card-header">
    <h4 class='card-title'>
      Dastavej
    </h4>
    <span>
      <%= link_to 'Add Dastavej', new_dastavej_path, class: "btn btn-primary btn-sm mt-2", data: {turbo: false} %>
    </span>
  </div>
  <div class="card-body">
    <table class="table">
      <thead>
        <tr>
          <th> Sr. No. </th>
          <th> Client </th>
          <th> Project </th>
          <th> Party Name </th>
          <th> Contact Number </th>
          <th> Status </th>
          <th> </th>
      </thead>
      <tbody>
        <%- @dastavejs.each_with_index do |dastavej, index| %>
          <tr>
            <td> <%= index + 1%> </td>
            <td> <%= dastavej.client.name %> </td>
            <td> <%= dastavej.project.name %> </td>
            <td> <%= dastavej.party_name %> </td>
            <td> <%= dastavej.contact_number %> </td>
            <td> <%= dastavej.status.name %> </td>
            <td> <%= link_to "view", dastavej_url(id: dastavej.uuid), data: {turbo: false} %> </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>