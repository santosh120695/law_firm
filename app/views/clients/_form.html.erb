<%= form_with(model: client, data: {turbo: false}) do |form| %>
  <% if client.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(client.errors.count, "error") %> prohibited this client from being saved:</h2>

      <ul>
        <% client.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class='form-group'>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :location, style: "display: block" %>
    <%= form.text_field :location, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :contact_no, style: "display: block" %>
    <%= form.text_field :contact_no, class: "form-control" %>
  </div>

  <div class="form-group mt-4">
    <button type="button" class="btn btn-light float-end" data-bs-dismiss="modal">Close</button>
    <%= form.submit class: "btn btn-primary float-end" %>
  </div>
<% end %>
