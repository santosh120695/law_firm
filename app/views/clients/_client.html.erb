<div id="<%= dom_id client %>">
  <p>
    <strong>Name:</strong>
    <%= client.name %>
  </p>

  <p>
    <strong>Uuid:</strong>
    <%= client.uuid %>
  </p>

  <p>
    <strong>Active:</strong>
    <%= client.active %>
  </p>

  <p>
    <strong>Location:</strong>
    <%= client.location %>
  </p>

  <p>
    <strong>Contact no:</strong>
    <%= client.contact_no %>
  </p>

</div>
