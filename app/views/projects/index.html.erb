<div class="card card-flush">
    <div class='card-header'>
        <h4 class="card-title">
            Projects
        </h4>
        <span class="mt-2">
            <%= link_to 'Add Project',"#" ,data:{bs_toggle: "modal", bs_target: "#project_new_modal"}, class: "btn btn-primary float-end" %>
        </span>
    </div>
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th> Project Name </th>
                    <th> Total Towers </th>
                    <th> Total Units </th>
                    <th> </th>
                </tr>
            </thead>

            <tbody>
                <% @projects.each do |project|  %>
                    <tr> 
                        <td> <%= project.name %> </td>
                        <td> <%= project.total_towers %> </td>
                        <td> <%= project.total_units %> </td>
                        <td> <%= link_to "view", project, data: {turbo: false} %> </td>
                    </tr>
                <% end %>
            </tbody>
        </table>
    </div>
</div>


<%= render "projects/project_modal", project: Project.new(client_id: @client&.id)%>