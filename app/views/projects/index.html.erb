<ul class="nav nav-custom nav-tabs nav-line-tabs nav-line-tabs-2x border-0 fs-4 fw-bold mb-n2">
	<li class="nav-item">
		<a class="nav-link text-active-primary pb-4 active" data-bs-toggle="tab" href="#kt_ecommerce_add_product_general">Projects</a>
	</li>
</ul>
<div class="card card-flush">
    <div class='card-header'>
        <h4 class="card-title">
            Projects
        </h4>
        <span class="mt-2">
            <%= link_to 'Add Project',"#" ,data:{bs_toggle: "modal", bs_target: "#project_new_modal"}, class: "btn btn-primary float-end" %>
        </span>
    </div>
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th> Project Name </th>
                    <th> Total Towers </th>
                    <th> Total Units </th>
                    <th> </th>
                </tr>
            </thead>

            <tbody>
                <% @projects.each do |project|  %>
                    <tr> 
                        <td> <%= project.name %> </td>
                        <td> <%= project.total_towers %> </td>
                        <td> <%= project.total_units %> </td>
                        <td> <%= link_to "view", project, data: {turbo: false} %> </td>
                    </tr>
                <% end %>
            </tbody>
        </table>
    </div>
</div>


<%= render "projects/project_modal", project: Project.new(client_id: @client&.id)%>