<%= form_with(model: payment_mode, data:{turbo: false}) do |form| %>
  <% if payment_mode.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(payment_mode.errors.count, "error") %> prohibited this payment_mode from being saved:</h2>

      <ul>
        <% payment_mode.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :uuid, style: "display: block" %>
    <%= form.text_field :uuid %>
  </div>

  <div>
    <%= form.label :active, style: "display: block" %>
    <%= form.check_box :active %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
