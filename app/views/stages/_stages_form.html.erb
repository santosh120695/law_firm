<table class='table table-bordered table-striped'>
<%- grouped_stages = item.stages.order("created_at ASC").group_by{ |stage| stage.stage_master.group }%>
    <%- grouped_stages.each do |grouped_stage, stages| %>
        <thead>
            <tr>
                <th> <%= grouped_stage %> </th>
            </tr>
            <tr>
                <th> </th>
                <th>  Date </th>
                <th>  Initial Entry </th>
                <th>  Final Entry </th>
            </tr>
        </thead>
        <tbody>
            <%- stages.each do |stage| %>
                <%= render "stages/form", stage: stage %>
            <% end %>
        </tbody>
    <% end %>
</table>