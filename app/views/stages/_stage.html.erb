<div id="<%= dom_id stage %>">
  <p>
    <strong>Item type:</strong>
    <%= stage.item_type %>
  </p>

  <p>
    <strong>Item:</strong>
    <%= stage.item_id %>
  </p>

  <p>
    <strong>Stage master:</strong>
    <%= stage.stage_master_id %>
  </p>

  <p>
    <strong>Stage date:</strong>
    <%= stage.stage_date %>
  </p>

  <p>
    <strong>Initial entry:</strong>
    <%= stage.initial_entry %>
  </p>

  <p>
    <strong>Final entry:</strong>
    <%= stage.final_entry %>
  </p>

</div>
