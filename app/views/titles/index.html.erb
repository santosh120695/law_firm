<div class="card card-flush">
	<div class="card-header align-items-center py-5 gap-2 gap-md-5">
		<div class="card-title">
			<div class="d-flex align-items-center position-relative my-1">
				<span class="svg-icon svg-icon-1 position-absolute ms-4">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
						<rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black"></rect>
						<path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black"></path>
					</svg>
				</span>
				<input type="text" data-kt-ecommerce-product-filter="search" class="form-control form-control-solid w-250px ps-14" placeholder="Search Title">
			</div>
		</div>
		<div class="card-toolbar flex-row-fluid justify-content-end gap-5">
			<div class="w-100 mw-150px">
				<select class="form-select form-select-solid" data-control="select2" data-hide-search="true" data-placeholder="Status" data-kt-ecommerce-product-filter="status">
					<option></option>
					<option value="overall" selected="selected">All</option>
					<option value="pending">Pending</option>
					<option value="published">New Published</option>
					<option value="generated">Title Generated</option>
					<option value="payment_clear">Payment Clear</option>
				</select>
			</div>
			<a href="<%= new_title_path %>" class="btn btn-primary">Add Title</a>
		</div>
	</div>
	<div id="example_wrapper" class="dataTables_wrapper dt-bootstrap5">
    <div class="row">
      <div class="col-sm-12">
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Name</th>
              <th>Position</th>
              <th>Office</th>
              <th>Age</th>
              <th>Start date</th>
              <th>Salary</th>
            </tr>
          </thead>
          <tbody>
            <%- @titles.each do |title| %>
              <tr>
                <td> <%=link_to title.client.name, title_path(id: title.uuid)  %> </td>
                <td> <%= title.client.name %> </td>
                <td> <%= title.taluka  %> </td>
                <td> <%= distance_of_time_in_words(Time.now, title.created_at)  %> </td>
                <td> <%= distance_of_time_in_words(Time.now, title.created_at)  %> </td>
                <td> <%= distance_of_time_in_words(Time.now, title.created_at)  %> </td>
              </tr>
            <% end %>
          </tbody>
        </table>
			</div>
    </div>
  </div>