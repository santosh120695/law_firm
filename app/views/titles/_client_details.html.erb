<div class="card card-flush py-4">
	<div class="card-header">
		<div class="card-title">
			<h2>Client Details</h2>
		</div>
		
	</div>
	<div class="card-body  pt-0">
		<p class="text-gray-400 fw-bold fs-5 mt-1 mb-7">Name: <%= title.client.name %></p>
		<p class="text-gray-400 fw-bold fs-5 mt-1 mb-7">Contact: <%= title.client.contact_no %></p>
		<div class="d-flex flex-wrap mb-5">
			<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-7 mb-3">
				<div class="fs-6 text-gray-800 fw-bolder"><%= title.client.titles.last(2).first.created_at.to_s(:short) %></div>
				<div class="fw-bold text-gray-400">Last Worked</div>
			</div>
			<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 mb-3">
				<div class="fs-6 text-gray-800 fw-bolder">Rs. 84,000/-</div>
				<div class="fw-bold text-gray-400">Total Earning</div>
			</div>
		</div>
	</div>
</div>