<%= form_with(model: tower, data: {turbo: false} ) do |form| %>
     <% if tower.errors.any? %>
         <div style="color: red">
         <h2><%= pluralize(tower.errors.count, "error") %> prohibited this project from being saved:</h2>
         <ul>
             <% tower.errors.each do |error| %>
             <li><%= tower.full_message %></li>
             <% end %>
         </ul>
         </div>
     <% end %>
     <div class='form-group mt-3'>
         <%= form.label :name, style: "display: block" %>
         <%= form.text_field :name, class: "form-control" %>
     </div>
     <div class='form-group mt-3'>
         <%= form.label :total_floor, style: "display: block" %>
         <%= form.number_field :total_floor, class: "form-control" %>
     </div>

    <% if tower.project_id.present? %>
        <%= form.hidden_field :project_id  %>
    <% else %>
        <div class="form-group mt-3">
            <%= form.label :project_id %>
            <%= form.select :project_id, Project.all.pluck(:name, :id), {include_blank: true}, {class: 'form-control'}%>
        </div>
    <% end %>

     <div class='form-group mt-4'>
        <a href="<%= towers_path %>" class="btn btn-light float-end" >Close</a>
        <%= form.submit class: "btn btn-primary float-end" %>
     </div>
 <% end %>