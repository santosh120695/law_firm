<div id="<%= dom_id pricing_detail %>">
  <p>
    <strong>Base price:</strong>
    <%= pricing_detail.base_price %>
  </p>

  <p>
    <strong>Additional amount:</strong>
    <%= pricing_detail.additional_amount %>
  </p>

  <p>
    <strong>Discount type:</strong>
    <%= pricing_detail.discount_type %>
  </p>

  <p>
    <strong>Tax class:</strong>
    <%= pricing_detail.tax_class %>
  </p>

  <p>
    <strong>Vat amount:</strong>
    <%= pricing_detail.vat_amount %>
  </p>

  <p>
    <strong>Title:</strong>
    <%= pricing_detail.title_id %>
  </p>

</div>
