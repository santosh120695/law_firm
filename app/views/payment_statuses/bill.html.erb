<div class="row justify-content-center" style="margin-top:4em">
    <div class='col-10'>
        <table class="table table-striped table-row-bordered table-row-gray-900">
            <thead>
                <tr> </tr>
                <tr class="fw-bolder fs-6 text-gray-800">
                    <th>Sr. No. </th>
                    <th> Date </th>
                    <th> Payment Mode </th>
                    <th> Payment Details </th>
                    <th> Amount </th>
                </tr>
            </thead>
            <tbody>
                <%- @payment_statuses.each_with_index do |payment_status, index| %>
                    <tr>
                        <td> <%= index + 1%> </td>
                        <td> <%= payment_status.created_at.strftime("%d-%m-%Y")%> </td>
                        <td> <%= payment_status.payment_mode.name%> </td>
                        <td> <%= payment_status.payment_detail  %> </td>
                        <td> <%= payment_status.amount %> </td>
                    </tr>
                <% end %>
                <tr>
                    <td colspan=3> Total </td>
                    <td> <%= @item.total_earned %> </td>
                </tr>
                <tr></tr>
            </tbody>
        </table>
    </div>
</div>
<div class='row justify-content-center mt-4'>
    <div class='col-1'>
        <button  class="btn btn-primary non-printable" onclick="print()"> Print </button>
    </div>
</div>